# Root-level routing for the site. This file is portable: do not add a
# RewriteBase or hard-coded installation path, because the production domain
# may be hosted at a different document root.
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Let the admin directory and every real admin PHP file be served directly.
    # This prevents /admin/index.php from being rewritten back through a
    # project-specific path and returning a 404 on a hosted domain.
    RewriteRule ^admin/?$ admin/index.php [L]
    RewriteRule ^admin/ - [L]

    # Never rewrite existing files or directories (assets, uploads and PHP
    # entry points must keep their physical paths).
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Optional clean public routes, e.g. /courses -> /courses.php.
    RewriteRule ^([A-Za-z0-9_-]+)/?$ $1.php [L,NC]
</IfModule>

# The application is served at this domain's document root.
ErrorDocument 404 /404.php

<IfModule mod_php.c>
    php_flag display_errors Off
</IfModule>
