Options -Indexes
RewriteEngine On
RewriteBase /LIVEpro/achievers/achievers_cms/

# ADMIN - bypass first
RewriteCond %{REQUEST_URI} ^/LIVEpro/achievers/achievers_cms/admin [NC]
RewriteRule ^ - [L]

RewriteRule ^admin/?$ admin/index.php [L]
RewriteRule ^admin/([a-zA-Z0-9_-]+)$ admin/$1.php [L]
RewriteRule ^admin/(.+\.php)$ admin/$1 [L]

# PUBLIC clean URLs
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !\.(php|css|js|jpg|jpeg|png|gif|ico|svg|webp|pdf|woff|woff2|map|txt|json)$ [NC]

RewriteRule ^([a-zA-Z0-9_-]+)$ $1.php [NC,L]

# Security
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

ErrorDocument 404 /LIVEpro/achievers/achievers_cms/404.php
php_flag display_errors Off
